

// Vertex shader
const vertexShaderSource = `
attribute vec3 vertex;
attribute vec3 normal;
attribute vec3 tangent;
attribute vec2 tex;
uniform mat4 ModelViewMatrix;
uniform mat4 ModelViewProjectionMatrix;

varying vec3 vPosition;     // view coordinates
varying vec3 vNormal;       // view coordinates
varying vec3 vTangent;      // view coordinates
varying vec2 vTexCoord;

void main() {
    vPosition = (ModelViewMatrix * vec4(vertex, 1.0)).xyz;
    vNormal  = (ModelViewMatrix * vec4(normal, 0.0)).xyz;     // ModelView has only rotations and a translation
    vTangent = (ModelViewMatrix * vec4(tangent, 0.0)).xyz;
    vTexCoord = tex;
    gl_Position = ModelViewProjectionMatrix * vec4(vertex, 1.0);
}`;


// Fragment shader: Phong shading with diffuse, specular and normal textures
const fragmentShaderSource = `
#ifdef GL_FRAGMENT_PRECISION_HIGH
   precision highp float;
#else
   precision mediump float;
#endif

uniform vec3 lightPosition;     // view coordinates
uniform sampler2D iTMU0;        // diffuse texture
uniform sampler2D iTMU1;        // specular texture
uniform sampler2D iTMU2;        // normal texture

varying vec3 vPosition;
varying vec3 vNormal;
varying vec3 vTangent;
varying vec2 vTexCoord;

void main() {
    // Gram-Schmidt orthogonalization with priority to the tangent:
    // T keeps its direction, the component along T is removed from the normal
    vec3 T = normalize(vTangent);
    vec3 N = normalize(vNormal);
    N = normalize(N - dot(N, T) * T);
    vec3 B = cross(N, T);

    // Normal from the normal texture: [0, 1] -> [-1, 1], then from tangent space (T, B, N) to view coordinates
    vec3 n = texture2D(iTMU2, vTexCoord).rgb * 2.0 - 1.0;
    N = normalize(mat3(T, B, N) * n);
    if (!gl_FrontFacing) N = -N;                        // the surface is open, its inner side is visible too

    vec3 L = normalize(lightPosition - vPosition);      // towards the light
    vec3 V = normalize(-vPosition);                     // towards the viewer (camera is at the origin)
    vec3 R = reflect(-L, N);

    float lambert = max(dot(N, L), 0.0);
    float spec = lambert > 0.0 ? pow(max(dot(R, V), 0.0), 32.0) : 0.0;

    vec3 kd = texture2D(iTMU0, vTexCoord).rgb;          // diffuse texture modulates the diffuse component
    vec3 ks = texture2D(iTMU1, vTexCoord).rgb;          // specular texture modulates the specular component

    vec3 ambient  = 0.15 * kd;
    vec3 diffuse  = 0.8 * lambert * kd;
    vec3 specular = spec * ks;

    gl_FragColor = vec4(ambient + diffuse + specular, 1.0);
}`;
